# ---------------------------------------------------------------------------
# Copy to .env and fill in. Only GCP_PROJECT is strictly required.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Vertex AI (generation) ---
# Your GCP project id. Required.
GCP_PROJECT=my-gcp-project-id

# Region serving the model. Keep the VM in the same region to minimise latency.
GCP_LOCATION=us-central1

# Generation model. Verify availability with: python scripts/verify_vertex.py
LLM_MODEL=gemini-2.5-flash

# Model used to read images and scanned PDFs at ingest. Defaults to LLM_MODEL.
# Must be multimodal.
# VISION_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# "vertex" -> Vertex AI embeddings. Better retrieval recall; costs per document
#             and needs credentials.
# "local"  -> in-process ONNX all-MiniLM-L6-v2. Free, offline, weaker.
#
# Switching providers changes the vector space AND the dimensionality, so the
# collection name encodes this configuration and a switch starts a fresh index.
# Re-upload documents after changing it.
EMBEDDING_PROVIDER=vertex
VERTEX_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# ---------------------------------------------------------------------------
# RAG tunables — defaults are calibrated; see execution.md sections 4 and 5.
# ---------------------------------------------------------------------------

# Chunking
# Large on purpose: small chunks fragment one idea across several records, so
# retrieval returns a piece of an answer rather than the answer.
CHUNK_SIZE=2000
CHUNK_OVERLAP=300
MIN_CHUNK_CHARS=40

# Retrieval
TOP_K=8

# Hybrid search: run BM25 alongside dense vectors and fuse the rankings.
# Set false for dense-only retrieval.
HYBRID_SEARCH=true

# Candidates each retriever contributes before fusion.
CANDIDATE_POOL=25

# The relevance gate. A chunk survives on EITHER semantic evidence (cosine
# distance within this threshold) or lexical evidence (BM25, below). If nothing
# survives, the API refuses WITHOUT calling the model.
#
# Deliberately permissive: wrongly refusing an answerable question is worse
# than passing a marginal chunk to the model, which still faces the `found`
# flag and citation validation behind it.
#
# The right value depends on the embedding model and your documents. Measure
# it:  python scripts/calibrate_threshold.py --relevant "..." --unrelated "..."
RELEVANCE_THRESHOLD=1.0

# Lexical admission. A chunk needs BOTH an absolute floor and a share of the
# best BM25 score for that query -- BM25 scores scale with corpus size, so a
# fixed threshold alone suits one corpus size and no other.
BM25_MIN_SCORE=0.3
BM25_MIN_RATIO=0.3

# Chat memory: how many prior turns to retain per session.
MAX_HISTORY_TURNS=6

# --- Storage ---
CHROMA_PATH=./data/chroma_db

# --- Limits (this can be exposed publicly; unbounded traffic costs credits) ---
MAX_UPLOAD_MB=20

# --- UI → API ---
# Local (outside Docker): http://localhost:8000
# Inside Docker Compose:  http://api:8000
API_BASE=http://localhost:8000

# --- Public address (production overlay only) ---
# ":80"            plain HTTP at the VM's IP — no DNS needed, NOT encrypted
# "example.com"    a hostname — Caddy gets a Let's Encrypt certificate
# SITE_ADDRESS=:80
#
# Password protection is NOT configured here — it lives in caddy-auth/, so the
# hash is never interpolated by Compose. See caddy-auth/README.md.

# --- Local Docker credentials (LOCAL DEV ONLY) ---
# Where gcloud stores Application Default Credentials on your machine. The
# base compose file mounts this read-only so the API container can authenticate.
#
#   macOS / Linux:  ~/.config/gcloud            (the default — leave unset)
#   Windows:        C:/Users/<you>/AppData/Roaming/gcloud
#
# Windows users MUST set this: gcloud writes ADC to %APPDATA%\gcloud, not to
# ~/.config/gcloud, so the default mount would be empty and auth would fail.
# Use forward slashes.
#
# Not used in production — the GCP VM's attached service account supplies
# credentials via the metadata server, and the prod overlay drops this mount.
# GCLOUD_CONFIG_DIR=C:/Users/YourName/AppData/Roaming/gcloud
